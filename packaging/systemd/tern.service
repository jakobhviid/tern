# systemd --user service for the tern background daemon.
# User/source install: binary at ~/.local/bin/ternd (this file → ~/.config/systemd/user/tern.service),
#   then: systemctl --user enable --now tern.service
# Native packages instead ship /usr/lib/systemd/user/tern.service with ExecStart=/usr/bin/ternd.
[Unit]
Description=tern — UniFi Identity client background service
Documentation=https://github.com/jakobhviid/tern
After=graphical-session.target
PartOf=graphical-session.target

# The Teleport tunnel creates a TUN device and configures the interface, needing CAP_NET_ADMIN (ADR-0016). A
# systemd --user service can't be granted ambient capabilities, so it's set as a *file* capability on the
# binary — `sudo setcap cap_net_admin+eip ~/.local/bin/ternd` (install-local.sh does this) — with the
# inheritable bit (`i`) so ternd can raise it into the ambient set at startup and its `ip`/`sysctl` helpers
# inherit it.
[Service]
Type=dbus
BusName=phd.hviid.Tern.Daemon
ExecStart=%h/.local/bin/ternd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
