# systemd --user service for the tern background daemon.
# User/source install: binary at ~/.local/bin/ternd (this file → ~/.config/systemd/user/tern.service),
#   then: systemctl --user enable --now tern.service
# Native packages instead ship /usr/lib/systemd/user/tern.service with ExecStart=/usr/bin/ternd.
[Unit]
Description=tern — UniFi Identity client background service
Documentation=https://github.com/jakobhviid/tern
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=phd.hviid.Tern
ExecStart=%h/.local/bin/ternd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
